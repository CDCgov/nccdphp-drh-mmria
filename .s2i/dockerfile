# S2I builder-image customization for MMRIA
# Base: dotnet-100 SDK on RHEL 9.8 (UBI 9)
# https://catalog.redhat.com/en/software/containers/ubi9/dotnet-100/672bc9015e6e9c0c6f7d2ff7
FROM default-route-openshift-image-registry.apps.ecpaas-dev.cdc.gov/trusted-images/dotnet-100:9.8-1784594615@sha256:c71106c2ad6009ee6238dc383f8bf4afe8539df2e4868ca0e1d9e1a724fe1d02

USER root

# Update libacl to address CVE-2026-54369 (symlink traversal privilege escalation;
# fixed in libacl-2.4.0-1.el9_8), then remove curl-minimal/libcurl-minimal because
# the customized S2I image only needs dotnet and shell tooling for assemble/run.
RUN dnf update -y libacl && \
    dnf remove -y curl-minimal libcurl-minimal && \
    dnf clean all

USER 1001
