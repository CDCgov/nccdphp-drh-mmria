{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Multi-Tenant DBs Only",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "launch-multi-tenant-dbs-only",
      "command": "echo Multi-tenant CouchDB pods are ready.",
      "cwd": "${workspaceFolder:nccdphp-drh-mmria}",
      "presentation": {
        "group": "main",
        "order": 0
      }
    },
    {
      "name": "Launch mmria-server (Single Tenant)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prepare-mmria-server-single-tenant",
      "requireExactSource": true,
      "program": "${workspaceFolder:nccdphp-drh-mmria}/source-code/mmria/mmria-server/bin/Debug/net9.0/mmria-server.dll",
      "args": [],
      "cwd": "${workspaceFolder:nccdphp-drh-mmria}/source-code/mmria/mmria-server",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "internalConsoleOptions": "openOnSessionStart",
      "sourceFileMap": {
        "/Views": "${workspaceFolder:nccdphp-drh-mmria}/Views"
      }
    },
    {
      "name": "Launch mmria-server (Multi Tenant)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prepare-mmria-server-multi-tenant",
      "requireExactSource": true,
      "program": "${workspaceFolder:nccdphp-drh-mmria}/source-code/mmria/mmria-server/bin/Debug/net9.0/mmria-server.dll",
      "args": [],
      "cwd": "${workspaceFolder:nccdphp-drh-mmria}/source-code/mmria/mmria-server",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "internalConsoleOptions": "openOnSessionStart",
      "sourceFileMap": {
        "/Views": "${workspaceFolder:nccdphp-drh-mmria}/Views"
      }
    },
    {
      "name": "Launch mmria-services",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-services",
      "requireExactSource": true,
      "program": "${workspaceFolder:nccdphp-drh-mmria}/nccdphp-drh-mmria-services/mmria.services/bin/Debug/net9.0/mmria.services.dll",
      "args": [],
      "cwd": "${workspaceFolder:nccdphp-drh-mmria}/nccdphp-drh-mmria-services/mmria.services",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "internalConsoleOptions": "openOnSessionStart",
      "sourceFileMap": {
        "/Views": "${workspaceFolder:nccdphp-drh-mmria}/Views"
      }
    },
    {
      "name": "Launch mmria-server (Single Tenant Raw)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "wait-for-mmria-services",
      "requireExactSource": true,
      "program": "${workspaceFolder:nccdphp-drh-mmria}/source-code/mmria/mmria-server/bin/Debug/net9.0/mmria-server.dll",
      "args": [],
      "cwd": "${workspaceFolder:nccdphp-drh-mmria}/source-code/mmria/mmria-server",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "internalConsoleOptions": "openOnSessionStart",
      "sourceFileMap": {
        "/Views": "${workspaceFolder:nccdphp-drh-mmria}/Views"
      },
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Launch mmria-server (Multi Tenant Raw)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "wait-for-mmria-services",
      "requireExactSource": true,
      "program": "${workspaceFolder:nccdphp-drh-mmria}/source-code/mmria/mmria-server/bin/Debug/net9.0/mmria-server.dll",
      "args": [],
      "cwd": "${workspaceFolder:nccdphp-drh-mmria}/source-code/mmria/mmria-server",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "internalConsoleOptions": "openOnSessionStart",
      "sourceFileMap": {
        "/Views": "${workspaceFolder:nccdphp-drh-mmria}/Views"
      },
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Launch mmria-services Raw",
      "type": "coreclr",
      "request": "launch",
      "requireExactSource": true,
      "program": "${workspaceFolder:nccdphp-drh-mmria}/nccdphp-drh-mmria-services/mmria.services/bin/Debug/net9.0/mmria.services.dll",
      "args": [],
      "cwd": "${workspaceFolder:nccdphp-drh-mmria}/nccdphp-drh-mmria-services/mmria.services",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "internalConsoleOptions": "openOnSessionStart",
      "sourceFileMap": {
        "/Views": "${workspaceFolder:nccdphp-drh-mmria}/Views"
      },
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Debug Aggregate Report Tests (Scenario A)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-aggregate-report-tests",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder:nccdphp-drh-mmria}/../nccdphp-drh-mmria-utilities/mmria-server.tests/mmria-server.tests.csproj",
        "--filter",
        "FullyQualifiedName~AggregateReportTests.Scenario_A_BasicCoverage",
        "--logger",
        "console;verbosity=detailed",
        "--no-build"
      ],
      "cwd": "${workspaceFolder:nccdphp-drh-mmria}/../nccdphp-drh-mmria-utilities/mmria-server.tests",
      "stopAtEntry": false,
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Debug All Aggregate Report Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-aggregate-report-tests",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder:nccdphp-drh-mmria}/../nccdphp-drh-mmria-utilities/mmria-server.tests/mmria-server.tests.csproj",
        "--filter",
        "Category=AggregateReport",
        "--logger",
        "console;verbosity=detailed",
        "--no-build"
      ],
      "cwd": "${workspaceFolder:nccdphp-drh-mmria}/../nccdphp-drh-mmria-utilities/mmria-server.tests",
      "stopAtEntry": false,
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Debug All Overdose Report Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-aggregate-report-tests",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder:nccdphp-drh-mmria}/../nccdphp-drh-mmria-utilities/mmria-server.tests/mmria-server.tests.csproj",
        "--filter",
        "Category=OverdoseReport",
        "--logger",
        "console;verbosity=detailed",
        "--no-build"
      ],
      "cwd": "${workspaceFolder:nccdphp-drh-mmria}/../nccdphp-drh-mmria-utilities/mmria-server.tests",
      "stopAtEntry": false,
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Debug Scenario_G (Direct)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-mmria-server-memory-tests",
      "program": "${workspaceFolder:nccdphp-drh-mmria}/../nccdphp-drh-mmria-utilities/mmria-server.tests/bin/Debug/net9.0/davinci",
      "args": [],
      "cwd": "${workspaceFolder:nccdphp-drh-mmria}/../nccdphp-drh-mmria-utilities/mmria-server.tests/bin/Debug/net9.0",
      "stopAtEntry": false,
      "console": "externalTerminal",
      "env": {
        "VSTEST_MODULE_FILTER": "mmria-server.tests.dll",
        "VSTEST_TRACE_FILTER": "OMMIT"
      }
    }
  ],
  "compounds": [
    {
      "name": "Launch Both (Single Tenant)",
      "configurations": [
        "Launch mmria-services Raw",
        "Launch mmria-server (Single Tenant Raw)"
      ],
      "preLaunchTask": "prepare-both-single-tenant",
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "main",
        "order": 1
      }
    },
    {
      "name": "Launch Both (Multi Tenant)",
      "configurations": [
        "Launch mmria-services Raw",
        "Launch mmria-server (Multi Tenant Raw)"
      ],
      "preLaunchTask": "prepare-both-multi-tenant",
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "main",
        "order": 2
      }
    }
  ]
}
