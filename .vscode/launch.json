{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (mmria-server)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "requireExactSource": true,
      "program": "${workspaceFolder}/source-code/mmria/mmria-server/bin/Debug/net9.0/mmria-server.dll",
      "args": [],
      "cwd": "${workspaceFolder}/source-code/mmria/mmria-server",
      "stopAtEntry": false,
      "internalConsoleOptions": "openOnSessionStart",
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}
