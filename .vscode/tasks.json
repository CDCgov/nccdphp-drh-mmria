{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-server",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder:nccdphp-drh-mmria}/source-code/mmria/mmria-server/mmria-server.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-services",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder:nccdphp-drh-mmria}/nccdphp-drh-mmria-services/mmria.services/mmria.services.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-both",
      "dependsOn": ["build-server", "build-services"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder:nccdphp-drh-mmria}/source-code/mmria/mmria-server/mmria-server.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}