{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (mmria-server)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "requireExactSource": true,
      "program": "${workspaceFolder}/mmria-server/bin/Debug/net9.0/mmria-server.dll",
      "args": [],
      "cwd": "${workspaceFolder}/mmria-server",
      "stopAtEntry": false,
      "internalConsoleOptions": "openOnSessionStart",
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": ".NET Core Launch (mmria.services)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "requireExactSource": false,
      "program": "${workspaceFolder}/mmria.services/bin/Debug/net9.0/mmria.services.dll",
      "args": [],
      "cwd": "${workspaceFolder}/mmria.services",
      "stopAtEntry": false,
      "internalConsoleOptions": "openOnSessionStart",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ],
  "compounds": [
    {
      "name": "Run Server and Services",
      "configurations": [
        ".NET Core Launch (mmria-server)",
        ".NET Core Launch (mmria.services)"
      ]
    }
  ]
}
