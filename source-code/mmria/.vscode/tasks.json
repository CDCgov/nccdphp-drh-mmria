{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/mmria-server/mmria-server.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-services",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/mmria.services/mmria.services.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-case-version",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/mmria.case_version/mmria.case_version.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-console",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/mmria-console/mmria-console.csproj"
      ],
      "problemMatcher": "$msCompile"
    },

    {
      "label": "build-sass",
      "command": "C:/program-file-set/sass/1.69.5/sass.bat",
      "type": "process",
      "args": [
        "${workspaceFolder}/mmria-server/sass/index.scss",
        "${workspaceFolder}/mmria-server/wwwroot/css/index.css"
      ],
      "problemMatcher": "$msCompile"
    },

    {
      "label": "build-identity",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/mmria-identity/mmria-identity.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "🔄 Pull Common Subtree",
      "type": "shell",
      "command": "cd $(git rev-parse --show-toplevel) && git subtree pull --prefix=source-code/mmria/common https://github.com/CDCgov/nccdphp-drh-mmria-common.git main --squash",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "⬆️ Push Common Subtree",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "Copy-Item -Path 'source-code/mmria/common/*' -Destination '../nccdphp-drh-mmria-common/' -Recurse -Force; Push-Location '../nccdphp-drh-mmria-common'; git add .; if (git status --porcelain) { git commit -m \"Sync from main repo $(Get-Date -Format 'yyyy-MM-dd HH:mm')\"; git push origin main; Write-Host '✅ Pushed!' -ForegroundColor Green } else { Write-Host 'No changes' -ForegroundColor Yellow }; Pop-Location"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
