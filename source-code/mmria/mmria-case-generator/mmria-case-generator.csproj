<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>mmria_case_generator</RootNamespace>
    <AssemblyName>mmria-case-generator</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bogus library for realistic fake data generation -->
    <PackageReference Include="Bogus" Version="35.6.1" />
    
    <!-- JSON serialization -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to mmria.common for metadata models -->
    <ProjectReference Include="..\..\..\nccdphp-drh-mmria-common\mmria.common\mmria.common.csproj" />
  </ItemGroup>

</Project>
