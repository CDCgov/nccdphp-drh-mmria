# Build image (SDK)
# https://catalog.redhat.com/en/software/containers/ubi8/dotnet-90/672bc9015e6e9c0c6f7d2ff7
FROM default-route-openshift-image-registry.apps.ecpaas-dev.cdc.gov/trusted-images/dotnet-90:9.0-1781603865@sha256:56fea381306c0c7c8f3082a50b41094006f53203c2d60a210535b242892ac2ba AS build
WORKDIR /src

# Copy the PMSS-specific csproj (use a wildcard in case exact filename varies)
COPY source-code/mmria/mmria-server/*pmss*.csproj ./source-code/mmria/mmria-server/

# Copy shared code and the rest of repository needed for project references
COPY source-code/mmria/ ./source-code/mmria/

USER root
WORKDIR /src/source-code/mmria/mmria-server

# Restore dependencies (uses cached layer when csproj unchanged)
RUN dotnet restore mmria-server.pmss.csproj

# Build specifying target framework (project is multi-targeted)
RUN dotnet build mmria-server.pmss.csproj -c Release -f net9.0 -o /app/build

USER 1001

# Publish stage
FROM build AS publish
USER root
WORKDIR /src/source-code/mmria/mmria-server
RUN dotnet publish mmria-server.pmss.csproj -c Release -f net9.0 -o /app/publish
USER 1001

# Runtime image (smaller)
# https://catalog.redhat.com/en/software/containers/ubi8/dotnet-90-runtime/672bc8de5e6e9c0c6f7d2f65
FROM default-route-openshift-image-registry.apps.ecpaas-dev.cdc.gov/trusted-images/dotnet-90-runtime:9.0-1781565773@sha256:90cb40265ebff488be71e474c44f83529807a52874579b6838392562279d6695 AS runtime
WORKDIR /app
COPY --from=publish /app/publish .

# Let the app bind to 8080 by default for OpenShift routing
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

# Run as non-root (OpenShift friendly)
USER 1001

# NOTE: adjust the DLL name below if the project outputs a different assembly name.
ENTRYPOINT ["dotnet", "mmria-server.pmss.dll"]