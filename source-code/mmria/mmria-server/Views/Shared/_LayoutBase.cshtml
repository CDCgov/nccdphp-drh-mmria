@using Microsoft.AspNetCore.Http.Extensions
@inject mmria.server.util.RequestTenantRuntime TenantRuntime
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
  var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
  bool is_pmss_enhanced = false;
  var offlineSessionIdleTimeoutMinutes = mmria.server.util.SessionTimeoutHelper.GetSessionIdleTimeoutMinutes(
    TenantRuntime.Configuration,
    TenantRuntime.Configuration ?? new mmria.common.couchdb.OverridableConfiguration(),
    TenantRuntime.EffectiveHostPrefix);

  #if IS_PMSS_ENHANCED
    is_pmss_enhanced = true;
  #endif
}
<!DOCTYPE html>
<html lang="en" class="theme-purple">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="request-verification-token" content="@antiforgeryTokens.RequestToken">
  
  @if(is_pmss_enhanced)
  {
    <meta name="description" content="The Pregnancy Mortality Surveillance System (PMSS) is a public health software tool created to collect, store, analyze and summarize information relevant to maternal deaths. The MMRIA serves 2 purposes: first to provide complete, detailed, and organized medical and social information that can be used by medical review committees to investigate individual maternal deaths; and second to provide a standardized cumulative database for future research and analysis on maternal mortality.">
    <title>@(ViewBag.Title + " | Pregnancy Mortality Surveillance System (PMSS)")</title>
  
  }
  else
  {
    <meta name="description" content="The Maternal Mortality Review Information App (MMRIA) is a public health software tool created to collect, store, analyze and summarize information relevant to maternal deaths. The MMRIA serves 2 purposes: first to provide complete, detailed, and organized medical and social information that can be used by medical review committees to investigate individual maternal deaths; and second to provide a standardized cumulative database for future research and analysis on maternal mortality.">
    <title>@(ViewBag.Title + " | Maternal Mortality Review Information App (MMRIA)")</title>
  }
  <link rel="shortcut icon" href="/TemplatePackage/4.0/assets/imgs/favicon.ico">
  <link rel="stylesheet prefetch" href="/TemplatePackage/4.0/assets/vendor/css/bootstrap.css">
  <link rel="stylesheet prefetch" href="/TemplatePackage/4.0/assets/css/app.min.css">
  <link rel="stylesheet" media="print" href="/TemplatePackage/4.0/assets/css/print.css">
  <link rel="stylesheet" href="/styles/mmria-custom.css">
  <link rel="stylesheet" href="/styles/template-package-override.css">



<script type="text/javascript">
if (top !== self) top.location.replace(self.location.href);
</script>


<script src="/TemplatePackage/4.0/assets/vendor/js/jquery.min.js"></script>
 @*  This optional RenderSection is used to inject custom scripts/links into the head tag *@
  @RenderSection("HeadScripts", false)
  @RenderSection("styles", false)
</head>

<body>

  @await Html.PartialAsync("_SkipToContent")
  @await Html.PartialAsync("_Header")
  @if (ViewBag.BreadCrumbs == true)
  {
    @await Html.PartialAsync("_BreadCrumbs")
  }

  <div class="site-content container body-wrapper bg-white d-flex mb-3 pb-3 pl-0 pr-0">
    <!-- <div class="row"> -->

      @if (ViewBag.Sidebar == true)
      {
        <aside class="app-sidebar col order-lg-1 leftnav-wrapper" tabindex="-1">
          @await Html.PartialAsync("_SideBarNav")
        </aside>
      }
    
      <main id="content"
            class="app-main col order-lg-2"
            role="main"
            aria-label="Main Content Area">
        @RenderBody()
      </main>
    <!-- </div> -->
  </div>
    
  @await Html.PartialAsync("_Footer")
  @await Html.PartialAsync("_Spinner")

  <script src="/scripts/mmria-custom.js"></script>
  <script src="/scripts/offline/offline-status-manager.js" type="text/javascript"></script>
  @if(ViewBag.is_offline_mode_enabled == true){
    <script>
      window.offline_session_timeout_config = {
        idle_timeout_minutes: @offlineSessionIdleTimeoutMinutes
      };
    </script>
    <script src="/scripts/offline/offline-logger.js"></script>
    <script src="/scripts/offline/offline-debug-modal.js"></script>
    <script src="/scripts/offline/offline-modals.js"></script>
    <script src="/scripts/offline/service-worker-manager.js"></script>
    <script src="/scripts/offline/offline-exit-manager.js"></script>
    <script>
      // Initialize offline logger with configuration from server
      if (typeof window.offlineLog !== 'undefined') {
        window.offlineLog.initialize(@Html.Raw((ViewBag.is_offline_logging_enabled ?? false) ? "true" : "false"), @(ViewBag.offline_logging_max_logs ?? 10000));
      }
    </script>
    <script src="/scripts/offline/offline-inactivity-manager.js"></script>
  }
  
  <script src="/scripts/shared/logout-handler.js"></script>

  <!-- System Offline: Warning modal (dismissable) -->
  <div id="mmria-warn-modal-backdrop" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1040;" aria-hidden="true"></div>
  <div id="mmria-warn-modal" role="dialog" aria-labelledby="mmria-warn-modal-title" aria-modal="true" aria-describedby="mmria-warn-modal-message" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; z-index:1050; overflow:auto;">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header" style="background-color:#7b2d8e; color:white; padding:10px 15px; display:flex; align-items:center; justify-content:space-between;">
          <h5 class="modal-title" id="mmria-warn-modal-title" style="margin:0; font-weight:600; font-size:17px;">System Notice</h5>
          <button type="button" class="mmria-warn-close-btn" onclick="closeWarnModal()" aria-label="Close"
            style="background:none; border:none; color:white; font-size:24px; line-height:1; cursor:pointer; padding:0; opacity:0.9;">
            &times;
          </button>
        </div>
        <div class="modal-body" style="padding:15px 20px;">
          <p id="mmria-warn-modal-message" style="margin:0; white-space:pre-wrap;"></p>
        </div>
        <div class="modal-footer" style="padding:10px 15px;">
          <button type="button" class="btn btn-primary mmria-warn-close-btn" onclick="closeWarnModal()">Dismiss</button>
        </div>
      </div>
    </div>
  </div>

  <!-- System Offline: Going-offline modal (non-dismissable) -->
  <div id="mmria-offline-modal-backdrop" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1040;" aria-hidden="true"></div>
  <div id="mmria-offline-modal" role="alertdialog" aria-labelledby="mmria-offline-modal-title" aria-modal="true" aria-describedby="mmria-offline-modal-message" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; z-index:1050; overflow:auto;">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header" style="background-color:#7b2d8e; color:white; padding:10px 15px;">
          <h5 class="modal-title" id="mmria-offline-modal-title" style="margin:0; font-weight:600; font-size:17px;">System Going Offline</h5>
        </div>
        <div class="modal-body" style="padding:15px 20px;">
          <p id="mmria-offline-modal-message" style="margin:0; white-space:pre-wrap;"></p>
          <p id="mmria-offline-modal-countdown" style="margin:10px 0 0; font-weight:bold; font-size:0.9em;" aria-live="polite"></p>
        </div>
        <div class="modal-footer" style="padding:10px 15px;">
          <button type="button" id="mmria-offline-modal-ok" class="btn btn-primary" onclick="mmria_offline_modal_ok_handler()">OK</button>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/system-offline-check.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Dismiss warning modal when backdrop is clicked.
      var warnBackdrop = document.getElementById('mmria-warn-modal-backdrop');
      if (warnBackdrop) {
        warnBackdrop.addEventListener('click', function () {
          if (typeof window.closeWarnModal === 'function') window.closeWarnModal();
        });
      }

      // Initial page load: fetch offline status and show modal if threshold is crossed.
      fetch('/api/system-offline/status', { credentials: 'same-origin' })
        .then(function (response) {
          if (!response.ok) return null;
          return response.json();
        })
        .then(function (config) {
          if (!config) return;
          var result = window.checkOfflineStatus(config);
          window.handleOfflineState(result, config);
        })
        .catch(function () { /* silently ignore network / parse errors */ });
      // Poll every 2 minutes while the user is on the page.
      window.startOfflineStatusPolling(120000);    });
  </script>

  @*Html.ReactGetScriptPaths()*@
  @RenderSection("Scripts", false)
  @*Html.ReactInitJavaScript()*@
</body>
</html>
