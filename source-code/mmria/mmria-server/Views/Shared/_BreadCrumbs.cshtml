@{ 
  bool is_pmss_enhanced = false;

  #if IS_PMSS_ENHANCED
    is_pmss_enhanced = true;
  #endif
}
<div class="container no-print">
  <div style="display: flex; justify-content: space-between; align-items: center;">
    <nav role="navigation" aria-label="Breadcrumb" class="breadcrumbs">
      <ol id="breadcrumb_list" class="breadcrumb">
          @if(is_pmss_enhanced)
          {
              <li class="breadcrumb-item"><a href="/">PMSS Home</a></li>
          }
          else
          {
              <li class="breadcrumb-item"><a href="/">MMRIA Home</a></li>
          }
        

        @* Logic to show secondary and tertiary links in the breadcrumbs *@

    </nav>
    <div id="offline-mode-indicator" style="display: none;">
      <button type="button" class="btn" style="background-color: #e3d3e4; color: #712177; font-weight: 600; border: 1px solid #ccc; padding: 4px 16px; display: flex; align-items: center;">
        <img src="~/img/offline-info.svg" alt="Offline Mode" style="width: 14px; height: 14px; margin-right: 8px;">
        Offline Mode
      </button>
    </div>
  </div>
</div>