@{
    #if !IS_PMSS_ENHANCED
        bool is_pmss_enhanced = false;
    #endif
    #if IS_PMSS_ENHANCED
        bool is_pmss_enhanced = true;
    #endif
    
}
<html lang="en" class="theme-purple">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="The Maternal Mortality Review Information App (MMRIA) is a public health software tool created to collect, store, analyze and summarize information relevant to maternal deaths. The MMRIA serves 2 purposes: first to provide complete, detailed, and organized medical and social information that can be used by medical review committees to investigate individual maternal deaths; and second to provide a standardized cumulative database for future research and analysis on maternal mortality.">
  <title>Maternal Mortality Review Information App (MMRIA) | CDC - Offline Login</title>
  <link rel="shortcut icon" href="/TemplatePackage/4.0/assets/imgs/favicon.ico">
  <link rel="stylesheet prefetch" href="/TemplatePackage/4.0/assets/vendor/css/bootstrap.css">
  <link rel="stylesheet prefetch" href="/TemplatePackage/4.0/assets/css/app.min.css">
  <link rel="stylesheet" media="print" href="/TemplatePackage/4.0/assets/css/print.css">
  <link rel="stylesheet" href="/styles/mmria-custom.css" />
  <link rel="stylesheet" href="/css/index.css" />

  <script src="/TemplatePackage/4.0/assets/vendor/js/jquery.min.js"></script>
  <script src="/scripts/jquery-ui.min.js"></script>

</head>

<body>

  @await Html.PartialAsync("_SkipToContent")

  @await Html.PartialAsync("_Header")

  <main
    id="content"
    role="main"
    aria-label="Main Content Area"
    >
    <div class="app-main purple-pattern">
    <div class="justify-content-center pt-3 col-md-12">
      @model OfflineApplicationUser
      @{
        <div class="mt-4 mb-4">
        <form id="offline_user_login" class="login container" asp-antiforgery="true" asp-controller="Account" asp-action="OfflineLogin"
          method="POST">
          <div class="ml-3 mr-3">
            
                @if(is_pmss_enhanced)
                {
                    <h1 class="login__title h3">
                    Welcome to PMSS
                    </h1>
                }
                else
                {
                    <h1 class="login__title h3">
                        Welcome to MMRIA
                    </h1>
                }
            <p class="login__info">Please enter your offline access key to continue. Contact your jurisdiction administrator if you have issues accessing the application.</p>
          </div>
          <div class="form-group vertical-control ml-3 mr-3">
            <label for="offline_login_key" class="login__label">Offline Access Key</label>
            <div>
                @if(ViewBag.LoginError != null)
                {
                    <div class="input-group">
                        <input name="OfflineKey" id="offline_login_key" aria-required="true" required autocomplete="off" aria-labelledby="offline_key_label" type="password" class="login__field error-text form-control col-md-12">
                        <div class="input-group-append">
                            <button id="offline_show_hide_key" aria-label="Show offline key" type="button" class="btn btn-inline-primary">
                                <span class="x22 fill-p cdc-icon-eye-solid"></span>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="input-group">
                        <input name="OfflineKey" id="offline_login_key" aria-required="true" required autocomplete="off" aria-labelledby="offline_key_label" type="password" class="login__field form-control col-md-12">
                        <div class="input-group-append">
                            <button id="offline_show_hide_key" aria-label="Show offline key" type="button" class="btn btn-inline-primary">
                                <span class="x22 fill-p cdc-icon-eye-solid"></span>
                            </button>
                        </div>
                    </div>
                }
                <i class="login__icon"></i>
            </div>
          </div>
            <div class="form-group" style="margin-left: 1.9rem;">
                <div id="offline_key_error_message" class="d-none error-banner col-md-12">
                    <img class="error-icon" src="../img/icon_error.svg" alt="error icon">
                    <span class="margin-pagealert mb-0 col-md-9">
                        Offline access key is required.
                    </span>
                </div>
            </div>
            @if(ViewBag.LoginError != null)
            {
                <div class="form-group" style="margin-left: 1.9rem;">
                    <div id="offline_login_error_message" class="error-banner col-md-12">
                        <img class="error-icon" src="../img/icon_error.svg" alt="error icon">
                        <span class="margin-pagealert mb-0 col-md-9">
                            @ViewBag.LoginError
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="form-group" style="margin-left: 1.9rem;">
                    <div id="offline_login_error_message" class="d-none error-banner col-md-12">
                        <img class="error-icon" src="../img/icon_error.svg" alt="error icon">
                        <span class="margin-pagealert mb-0 col-md-9">
                            @ViewBag.LoginError
                        </span>
                    </div>
                </div>
            }
          <div class="form-controls horizontal-control col-md-12 justify-content-center">
            <button id="offline_login_button" name="submit" type="submit" class="login__btn primary-button col-md-12">Login</button>
          </div>
          <input type="hidden" name="returnUrl" value="@TempData["returnUrl"]" />
        </form>
    </div>
      }
      <div class="box container p-3" style="font-size: 14px">
        <p><strong>Offline Mode Information</strong></p>
        <ul>
          <li>Offline mode allows you to access the application without an internet connection.</li>
          <li>Your offline access key is provided by your jurisdiction administrator.</li>
          <li>Data entered in offline mode will be synchronized when you reconnect to the internet.</li>
          <li>Some features may be limited in offline mode.</li>
        </ul>
        <p><strong>Conditions of Use</strong></p>
        <ul>
          <li>This warning banner provides privacy and security notices consistent with applicable federal laws, directives, and other federal guidance for accessing this Government system, which includes (1) this computer network, (2) all computers connected to this network, and (3) all devices and storage media attached to this network or to a computer on this network.</li>
          <li>This system is provided for Government-authorized use only.</li>
          <li>Unauthorized or improper use of this system is prohibited and may result in disciplinary action and/or civil and criminal penalties.</li>
          <li>Personal use of social media and networking sites on this system is limited as to not interfere with official work duties and is subject to monitoring.</li>
          <li>By using this system, you understand and consent to the following:
            <ul>
              <li>The Government may monitor, record, and audit your system usage, including usage of personal devices and email systems for official duties or to conduct HHS business. Therefore, you have no reasonable expectation of privacy regarding any communication or data transiting or stored on this system. At any time, and for any lawful Government purpose, the government may monitor, intercept, and search and seize any communication or data transiting or stored on this system.</li>
              <li>Any communication or data transiting or stored on this system may be disclosed or used for any lawful Government purpose.</li>
            </ul>
          </li>
        </ul>
      </div>
    </div>
    </div>
  </main>


  @await Html.PartialAsync("_Footer")
  
  <script src="/scripts/mmria-custom.js"></script>
  <script src="/scripts/offline/offline-logger.js"></script>
  <script>
    if (typeof window.offlineLog !== 'undefined') {
      window.offlineLog.initialize(true, @(ViewBag.offline_logging_max_logs ?? 10000));
    }
  </script>
  <script src="/scripts/offline/offline-debug-modal.js"></script>
  <script src="/scripts/offline/offline-cache-manifest.js"></script>
  <script src="/scripts/offline/offline-integrity-validator.js"></script>
  <script src="/scripts/offline/service-worker-manager.js"></script>
  <script src="/scripts/Account/offline_key_login.js"></script>
</body>
</html>
