@using System.Security.Claims;
@{ 
    Layout = "_LayoutBase";
    ViewBag.BreadCrumbs = true;
    ViewBag.Sidebar = false;
    ViewBag.Title = "Manage Case Checkouts";

    var userName = "";

    if(User.Identity != null && User.Identity.IsAuthenticated)
    {
        userName = User.Identities.First(
        u => u.IsAuthenticated && 
        u.HasClaim(c => c.Type == ClaimTypes.Name)).FindFirst(ClaimTypes.Name).Value;
    }
    var is_offline_mode_enabled = TempData["is_offline_mode_enabled"];
    var offline_mode_max_new_cases = TempData["offline_mode_max_new_cases"];
    var offline_mode_max_existing_cases = TempData["offline_mode_max_existing_cases"];

}

@section HeadScripts
{
    <script>
        const is_offline_mode_enabled = @is_offline_mode_enabled.ToString().ToLower();
        const offline_mode_max_new_cases = @offline_mode_max_new_cases;
        const offline_mode_max_existing_cases = @offline_mode_max_existing_cases;
    </script>  
    <script src="./scripts/mmria.js"></script>
    <script src="./scripts/manage-case-check-outs/index.js"></script>
