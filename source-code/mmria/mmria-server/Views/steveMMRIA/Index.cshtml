@using System.Security.Claims;
@{
    Layout = "_LayoutBase";

    ViewBag.BreadCrumbs = true;
    ViewBag.Title = "Steve MMRIA";

    var is_cdc_admin = false;
    var is_abstractor = false;

    var userName = "";
  
    if (User.Identities.Any(u => u.IsAuthenticated))
    {
        userName = User.Identities.First(
        u => u.IsAuthenticated && 
        u.HasClaim(c => c.Type == ClaimTypes.Name)).FindFirst(ClaimTypes.Name).Value;
    }

    foreach(var role in User.Identities.First(u => u.IsAuthenticated &&  u.HasClaim(c => c.Type == ClaimTypes.Name)).Claims.Where(c=> c.Type == ClaimTypes.Role))
    {
      switch(role.Value)
      {
        case "abstractor":
          is_abstractor = true;
          break;
        case "cdc_admin":
          is_cdc_admin = true;
          break;
      }
    }

    var BeginDate = "";
    var EndDate = "";

    if(DateTime.Now.DayOfWeek == DayOfWeek.Monday)
    {
        var friday = DateTime.Now.AddDays(-3);
        BeginDate = $"{friday.Year}-{friday.Month:00}-{friday.Day:00}";
        var yesterday = DateTime.Now.AddDays(-1);
        EndDate = $"{yesterday.Year}-{yesterday.Month:00}-{yesterday.Day:00}";
    }
    else
    {
        var yesterday = DateTime.Now.AddDays(-1);
        BeginDate = $"{yesterday.Year}-{yesterday.Month:00}-{yesterday.Day:00}";
        EndDate = $"{yesterday.Year}-{yesterday.Month:00}-{yesterday.Day:00}";
    }


}

@section HeadScripts
{
    <script src="../scripts/mmria.js" type="text/javascript"></script>
    <script src="../scripts/steveMMRIA/index.js" type="text/javascript"></script>
}

<h1 class="h2 mb-4" tabindex="-1">STEVE - Vital Records Data Download</h1> <button class="btn btn-primary mt-3 d-none">Clear All TEST Data</button>
@section styles {
    <link rel="stylesheet" href="/css/index.css">
}
@* if(is_cdc_admin)
{
    <p><a id="clear_data">clear test data</a></p>
}*@

<div class="vertical-control col-md-3 pl-0">
    <label for="BeginDate" class="font-weight-semi">Begin Date</label>
    <input id="BeginDate" type="Date" value="@BeginDate" class="form-control"/>
</div>
<div class="vertical-control col-md-3 pl-0">
    <label for="EndDate" class="font-weight-semi">End Date</label>
    <input id="EndDate" type="Date" value="@EndDate" class="form-control"/>
</div>
<div class="vertical-control col-md-3 pl-0">
    <label for="Mailbox" class="font-weight-semi">STEVE Mailbox</label>
    <select id="Mailbox" class="form-select form-control">
    <option>(Select Value)</option>
    <option selected>All</option>
    <option>Mortality</option>
    <option>Fetal Death</option>
    <option>Natality</option>
    <option>Other</option>
    </select>
</div>
<div class="horizontal-control col-md-12 pl-0 mt-2">
    <button id="StartDownloadButton" class="primary-button mr-1">Start Download</button>
    <button id="Refresh" class="secondary-button">Refresh Download Listing</button>    
</div>
<div class="vertical-control col-md-12 pl-0 mt-2">
    <div id="queue_result"></div>
</div>
